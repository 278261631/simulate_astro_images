{
  "server": {
    "host": "127.0.0.1",
    "port": 11111,
    "discovery_enabled": true,
    "discovery_port": 32227
  },
  "nina": {
    "base_url": "http://127.0.0.1:1888",
    "api_key": "",
    "timeout_seconds": 3.0,
    "mount_coordinates_path": "/v2/api/equipment/mount/info",
    "mount_fallback_paths": ["/v2/api/equipment/telescope/info", "/api/v2/mount/coordinates", "/api/v2/mount"],
    "focus_position_path": "/v2/api/equipment/focuser/info",
    "focus_fallback_paths": ["/api/v2/focuser/position", "/api/v2/focuser"],
    "ra_unit": "auto"
  },
  "camera": {
    "name": "NINA Simulated Alpaca Camera",
    "sensor_type": "mono",
    "numx": 1024,
    "numy": 1024,
    "pixel_size_um": 3.75,
    "focal_length_mm": 21.95,
    "gain_default": 100,
    "gain_min": 0,
    "gain_max": 300,
    "offset_default": 50,
    "offset_min": 0,
    "offset_max": 300,
    "exposure_min": 0.001,
    "exposure_max": 3600.0,
    "exposure_resolution": 0.001,
    "readout_modes": ["Default", "Low Noise"]
  },
  "render": {
    "catalog": "../data/hip_catalog.csv",
    "max_mag": 12.0,
    "roll_deg": 0.0,
    "tone_gain": 2.0,
    "psf_sigma_min": 0.8,
    "psf_sigma_max": 8.0,
    "focus_ideal": 0,
    "focus_span": 1000,
    "brightness": 40000,
    "bias": 1200,
    "simulate_noise": false,
    "noise_sigma": 40.0,
    "vignetting": 0.35
  }
}
